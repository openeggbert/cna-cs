<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EngineBench</AssemblyName>
    <RootNamespace>EngineBench</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Which XNA implementation this build compiles the one shared Program.cs against. The
         whole point of the tool is that the source is identical for all three. -->
    <Engine Condition="'$(Engine)' == ''">CNA</Engine>
    <CnaCsRoot Condition="'$(CnaCsRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</CnaCsRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(Engine)' == 'CNA'">
    <ProjectReference Include="$(CnaCsRoot)/src/CNA.XnaCompat/CNA.XnaCompat.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Engine)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>
  <ItemGroup Condition="'$(Engine)' == 'Kni'">
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.SDL2.GL" Version="4.2.9001.1" />
  </ItemGroup>
</Project>
