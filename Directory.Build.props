<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>

    <Authors>openeggbert</Authors>
    <Company>openeggbert</Company>
    <Product>CNA.NET</Product>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/openeggbert/cna-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openeggbert/cna-dotnet</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Production projects stay non-packable by default. The release-qualification harness opts
       only these three managed projects into isolated local preview packing. -->
  <PropertyGroup Condition="'$(CnaPackageAcceptance)' == 'true' and
      ('$(MSBuildProjectName)' == 'CNA.Interop' or '$(MSBuildProjectName)' == 'CNA.Framework' or '$(MSBuildProjectName)' == 'CNA.XnaCompat')">
    <IsPackable>true</IsPackable>
    <Version Condition="'$(CnaPackageVersion)' != ''">$(CnaPackageVersion)</Version>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(CnaPackageAcceptance)' == 'true' and
      ('$(MSBuildProjectName)' == 'CNA.Interop' or '$(MSBuildProjectName)' == 'CNA.Framework' or '$(MSBuildProjectName)' == 'CNA.XnaCompat')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
